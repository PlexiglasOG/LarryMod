{
  "schemaVersion": 1,
  "id": "larrymod",
  "version": "${version}",
  "name": "LarryMod",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/larrymod/icon.png",
  "environment": "client",
  "entrypoints": {
